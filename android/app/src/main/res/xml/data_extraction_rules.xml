        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="sharedpref" path="sqlite_encrypted_shared_prefs.xml" />
        <exclude domain="database" path="private-activitySQLite.db" />
